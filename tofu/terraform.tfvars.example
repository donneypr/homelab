# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# Credentials come from the environment, not this file:
#   export PROXMOX_VE_ENDPOINT="https://192.168.2.x:8006/"
#   export PROXMOX_VE_API_TOKEN="terraform@pve!provider=<secret>"

proxmox_insecure = true

network_gateway = "192.168.2.1"

# Pi-hole first, public resolver second so the nodes keep DNS if Pi-hole is down
dns_servers = ["192.168.2.CHANGEME", "1.1.1.1"]

ssh_public_keys = [
  "ssh-ed25519 AAAA... don@macbook",
]

# Start with one node. Add the other two once the first VM boots and you can SSH in.
k3s_nodes = {
  "k3s-1" = {
    proxmox_node = "pve1"
    vm_id        = 201
    ipv4_cidr    = "192.168.2.31/24"
  }

  # "k3s-2" = {
  #   proxmox_node = "pve2"
  #   vm_id        = 202
  #   ipv4_cidr    = "192.168.2.32/24"
  # }
  #
  # "k3s-3" = {
  #   proxmox_node = "pve3"
  #   vm_id        = 203
  #   ipv4_cidr    = "192.168.2.33/24"
  # }
}
