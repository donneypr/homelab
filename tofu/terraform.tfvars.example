# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# Credentials come from the environment, not this file:
#   export PROXMOX_VE_ENDPOINT="https://192.168.2.x:8006/"
#   export PROXMOX_VE_API_TOKEN="terraform@pve!provider=<secret>"

proxmox_insecure = true

network_gateway = "192.168.2.1"

dns_servers = ["192.168.2.1", "1.1.1.1"]

ssh_public_keys = [
  "ssh-ed25519 AAAA... don@macbook",
]

# The LAN reserves 192.168.2.240-254 for static assignment.
# DHCP hands out 192.168.2.10-239.
k3s_nodes = {
  "k3s-1" = {
    proxmox_node = "pve1"
    vm_id        = 201
    ipv4_cidr    = "192.168.2.201/24"
  }

  "k3s-2" = {
    proxmox_node = "pve2"
    vm_id        = 202
    ipv4_cidr    = "192.168.2.202/24"
  }

  "k3s-3" = {
    proxmox_node = "pve3"
    vm_id        = 203
    ipv4_cidr    = "192.168.2.203/24"
  }
}
